# Copy this file to .env (same folder) and fill in your real key.
# .env is gitignored — never commit your actual key.
# Only ONE provider block should be active (uncommented) at a time.

# --- Mistral (default): free "Experiment" tier, no card, ~1B tokens/month ---
LLM_PROVIDER=mistral
MISTRAL_API_KEY=your_real_key_here

# --- Groq: free tier alternative, no card ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your_real_key_here

# --- From Aug 21, once Kimi credits are bought ---
# LLM_PROVIDER=moonshot
# MOONSHOT_API_KEY=sk_your_real_key_here
